{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "customConditions": [
      "react-native"
    ]
  },
  "include": [
    "App.js",
    "stuff/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "tests",
    "ios",
    "android"
  ]
}
